et:0}}@media (max-width:420px){.ld-mark{width:92px;height:92px}.ld-name{font-size:36px}.ld-logo{max-height:56px}}@media (prefers-reduced-motion:reduce){.ld-arc{animation:none}.ld-art>*{animation:none;stroke-dashoffset:0}}.selldone-ready .ld{opacity:0}</style><script>window.addEventListener(\"message\",function(e){if(e.source!==parent||!e.data||e.data.type!==\"selldone-app-loaded\")return;document.documentElement.classList.add(\"selldone-ready\")});</script>",
